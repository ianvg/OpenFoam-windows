<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <ApplicationTitle>Foam Studio</ApplicationTitle>
    <DefaultLanguage>en-US</DefaultLanguage>
    <ApplicationId>com.ianvg.foamstudio</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>Ian Van Giesen</ApplicationPublisher>
    <Description>Windows interface for OpenFOAM through WSL2.</Description>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../FoamStudio.OpenFoam/FoamStudio.OpenFoam.csproj" />
  </ItemGroup>
</Project>
