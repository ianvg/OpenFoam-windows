<Page x:Class="FoamStudio.App.MainPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="28" RowSpacing="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Spacing="6">
      <TextBlock Text="Foam Studio" FontSize="30" FontWeight="SemiBold" />
      <TextBlock Text="Environment &amp; first simulation" FontSize="18" />
      <TextBlock Text="Run the OpenFOAM Foundation 13 cavity tutorial through WSL2." TextWrapping="Wrap" />
    </StackPanel>
    <Grid Grid.Row="1" ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <ComboBox x:Name="Distribution" Header="WSL distribution" HorizontalAlignment="Stretch" SelectionChanged="EnvironmentChanged" />
      <TextBox x:Name="Bashrc" Grid.Column="1" Header="OpenFOAM environment file (Linux path)" TextChanged="EnvironmentTextChanged" />
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
      <Button x:Name="Refresh" Content="Refresh distributions" Click="RefreshClicked" />
      <Button x:Name="Check" Content="Check environment" Click="CheckClicked" />
      <Button x:Name="Run" Content="Run cavity" Click="RunClicked" IsEnabled="False" />
      <Button x:Name="Stop" Content="Stop" Click="StopClicked" IsEnabled="False" />
      <ProgressRing x:Name="Busy" Width="24" Height="24" IsActive="False" />
    </StackPanel>
    <InfoBar x:Name="Status" Grid.Row="3" IsOpen="True" IsClosable="False"
             Severity="Informational" Title="Check your environment to begin." />
    <Border Grid.Row="4" CornerRadius="8" BorderThickness="1" BorderBrush="Gray" Padding="12">
      <ScrollViewer x:Name="LogScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="Log" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" />
      </ScrollViewer>
    </Border>
    <TextBlock x:Name="CaseLocation" Grid.Row="5" Text="Each run creates a separate case in the selected distribution. Logs stay with the case."
               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
  </Grid>
</Page>
